---
// Placeholder artwork. Swap for a Sanity image later.
const { hue = 200, class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 400 500" role="img" aria-label="Placeholder artwork" xmlns="http://www.w3.org/2000/svg">
  <defs><linearGradient id={`g${hue}`} x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color={`hsl(${hue} 35% 22%)`} /><stop offset="1" stop-color={`hsl(${(hue + 40) % 360} 45% 10%)`} />
  </linearGradient></defs>
  <rect width="400" height="500" fill={`url(#g${hue})`} />
  <circle cx="270" cy="170" r="90" fill={`hsl(${hue} 55% 55% / .35)`} />
  <rect x="60" y="320" width="280" height="2" fill={`hsl(${hue} 30% 80% / .5)`} />
</svg>
