---
// Shows the real image when `src` is set, otherwise a generated placeholder. rw/rh = aspect ratio (no cropping).
const { hue = 200, rw = 4, rh = 5, src, alt = 'Placeholder artwork', class: cls = '', eager = false, sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' } = Astro.props;
const H = Math.round((400 * rh) / rw);
// Sanity CDN images: offer several widths so cards do not download the full-size file.
const isCdn = typeof src === 'string' && src.startsWith('https://cdn.sanity.io/');
const srcset = isCdn ? [480, 800, 1200, 1600].map((w) => `${src.split('?')[0]}?w=${w}&auto=format&q=82 ${w}w`).join(', ') : undefined;
---
{src ? <img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} alt={alt} width={400} height={H} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" class={cls} /> : (
<svg class={cls} viewBox={`0 0 400 ${H}`} role="img" aria-label={alt} xmlns="http://www.w3.org/2000/svg">
  <defs><linearGradient id={`g${hue}`} x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color={`hsl(${hue} 35% 22%)`} /><stop offset="1" stop-color={`hsl(${(hue + 40) % 360} 45% 10%)`} />
  </linearGradient></defs>
  <rect width="400" height={H} fill={`url(#g${hue})`} />
  <circle cx="270" cy={H * 0.34} r="90" fill={`hsl(${hue} 55% 55% / .35)`} />
  <rect x="60" y={H * 0.64} width="280" height="2" fill={`hsl(${hue} 30% 80% / .5)`} />
</svg>)}
