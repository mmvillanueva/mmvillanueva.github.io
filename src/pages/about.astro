---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import { artist } from '../data/works';
---
<Base title={`About · ${artist.name}`}>
  <section class="py-10 md:py-16 grid md:grid-cols-[1fr_1.4fr] gap-8 md:gap-16 items-start max-w-5xl mx-auto">
    <Plate hue={30} rw={4} rh={5} alt="Placeholder portrait of the artist" class="w-full max-w-sm" />
    <div>
      <h1 class="text-mute text-xs uppercase tracking-widest mb-6">About</h1>
      <p class="font-serif text-4xl leading-snug mb-8">{artist.statement}</p>
      <p class="text-mute">Mario Villanueva is a Filipino visual artist based in Manila, working primarily in oil, acrylic, watercolor, and charcoal. His practice centers on quiet, observed moments—light on water, the hush of a garden at dusk, the stillness of everyday objects—rendered with a restrained palette and an eye for atmosphere. He shows regularly in local galleries and artist-run spaces.</p>
    </div>
  </section>
</Base>
