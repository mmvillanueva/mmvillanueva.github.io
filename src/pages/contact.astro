---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import ContactForm from '../components/ContactForm.astro';
import { artist } from '../data/works';
---
<Base title={`Contact · ${artist.name}`} description={`Commissions and general questions for ${artist.name}.`}>
  <section class="py-10 md:py-16 grid md:grid-cols-[1.2fr_1fr] gap-10 md:gap-16 items-start max-w-5xl mx-auto">
    <div>
      <h1 class="text-mute text-xs uppercase tracking-widest mb-6">Contact</h1>
      <p class="font-serif text-4xl mb-3 max-w-xl">For commissions and general questions.</p>
      <p class="text-mute mb-10 max-w-xl">Interested in a specific painting? If it is available, you will find an inquiry form on its page.</p>
      <ContactForm />
    </div>
    <Plate hue={200} rw={3} rh={4} src={artist.studio} alt={artist.studio ? `${artist.name}'s studio` : "Placeholder photo of the artist's studio"} class="w-full max-w-sm md:justify-self-end" />
  </section>
</Base>
