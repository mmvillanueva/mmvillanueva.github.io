---
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import ContactForm from '../../components/ContactForm.astro';
import { works } from '../../data/works';
export function getStaticPaths() {
  return works.map((w, i) => ({ params: { slug: w.slug }, props: { w, prev: works[i - 1], next: works[i + 1] } }));
}
const { w, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const labels = { available: 'Available', reserved: 'Reserved', sold: 'Sold' };
---
<Base title={`${w.title} · No. ${w.no}`}>
  <a href={`${base}/#works`} class="text-xs text-mute hover:text-ember">← All works</a>
  <article class="grid md:grid-cols-[1.2fr_1fr] gap-12 py-10">
    <button type="button" id="art" aria-label={`View ${w.title} larger`} data-cursor="Zoom" class="reveal block w-full text-left cursor-zoom-in">
      <Plate hue={w.hue} rw={w.rw} rh={w.rh} src={w.image} alt={`${w.title}, ${w.medium}`} class="w-full max-h-[80vh]" />
    </button>
    <div class="reveal self-end">
      <p class="text-mute">No. {w.no}</p>
      <h1 class="font-serif text-6xl leading-none my-3">{w.title}</h1>
      <dl class="text-mute grid gap-1 mb-6"><div>{w.year} · {w.medium}</div><div>{w.size}</div>
        <div class={`st-${w.status}`}><span class={`dot ${w.status}`}></span>{labels[w.status]}</div></dl>
      <p class="font-serif text-4xl mb-6">{w.price}</p>
      <p class="mb-8 max-w-md">{w.note}</p>
      {w.status === 'available' ? (
        <>
          <button id="inquire" type="button" aria-expanded="false" aria-controls="inquiry" class="inline-flex items-center gap-3 border border-ember text-ember px-5 py-2 hover:bg-ember hover:text-ink">
            <span class="plus" aria-hidden="true">+</span> Inquire about this work
          </button>
          <div id="inquiry" class="collapse"><div class="pt-8 pb-1 px-1"><ContactForm work={w.no} /></div></div>
        </>
      ) : (
        <p class="text-mute max-w-md border-t border-line pt-6">
          {w.status === 'reserved' ? 'This work is currently reserved.' : 'This work has been sold.'}{' '}
          <a class="text-ember underline underline-offset-4" href={`${base}/contact/`}>Contact the artist about similar work →</a>
        </p>
      )}
    </div>
  </article>
  <nav class="flex justify-between text-xs py-8 border-t border-line">
    {prev ? <a class="hover:text-ember" href={`${base}/works/${prev.slug}/`}>← {prev.title}</a> : <span />}
    {next ? <a class="hover:text-ember" href={`${base}/works/${next.slug}/`}>{next.title} →</a> : <span />}
  </nav>
  <dialog id="lightbox" class="lightbox" aria-label={`${w.title}, enlarged`}>
    <div id="lb-stage" class="lb-stage"></div>
    <button type="button" id="lb-close" aria-label="Close enlarged view" class="absolute top-5 right-6 text-xs uppercase tracking-widest text-mute hover:text-ember">Close</button>
  </dialog>
</Base>
<script>
  // Inquiry panel: smooth expand/collapse, then move focus to the first field
  const inquire = document.getElementById('inquire'), panel = document.getElementById('inquiry');
  if (inquire && panel) {
    inquire.addEventListener('click', () => {
      const open = inquire.getAttribute('aria-expanded') !== 'true';
      inquire.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('open', open);
      if (open) setTimeout(() => {
        panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        panel.querySelector<HTMLInputElement>('input[name="name"]')?.focus({ preventScroll: true });
      }, 500);
    });
  }

  // Click-to-zoom lightbox: first click opens the viewer, clicking the artwork magnifies it, moving the pointer pans.
  const art = document.getElementById('art');
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const stage = document.getElementById('lb-stage');
  if (art && dlg && stage && typeof dlg.showModal === 'function') {
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const aspect = (el: Element): number => {
      if (el instanceof HTMLImageElement) return el.naturalWidth && el.naturalHeight ? el.naturalWidth / el.naturalHeight : el.width / el.height;
      const vb = (el as SVGSVGElement).viewBox?.baseVal;
      return vb && vb.height ? vb.width / vb.height : 1;
    };
    const origin = (e: PointerEvent | MouseEvent) => {
      const r = stage.getBoundingClientRect();
      const img = stage.firstElementChild as HTMLElement | null;
      if (img) img.style.transformOrigin = `${((e.clientX - r.left) / r.width) * 100}% ${((e.clientY - r.top) / r.height) * 100}%`;
    };
    const open = () => {
      const src = art.querySelector('img, svg');
      if (!src) return;
      const clone = src.cloneNode(true) as HTMLElement;
      ['loading', 'class', 'width', 'height'].forEach((a) => clone.removeAttribute(a));
      stage.replaceChildren(clone);
      stage.classList.remove('zoomed');
      stage.style.setProperty('--ar', String(aspect(src)));
      dlg.showModal();
      void dlg.offsetWidth;
      dlg.classList.add('is-open');
    };
    const close = () => {
      dlg.classList.remove('is-open');
      setTimeout(() => dlg.close(), still.matches ? 0 : 450);
    };
    art.addEventListener('click', open);
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.addEventListener('close', () => stage.replaceChildren());
    document.getElementById('lb-close')?.addEventListener('click', close);
    stage.addEventListener('click', (e) => { origin(e); stage.classList.toggle('zoomed'); });
    stage.addEventListener('pointermove', (e) => { if (stage.classList.contains('zoomed')) origin(e); });
  }
</script>
