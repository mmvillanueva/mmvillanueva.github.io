---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Page not found" description="This page could not be found." noindex>
  <section class="py-16 md:py-24 max-w-xl">
    <h1 class="text-mute text-xs uppercase tracking-widest mb-6">404</h1>
    <p class="font-serif text-5xl mb-6">This page could not be found.</p>
    <a href={`${base}/`} class="text-ember underline underline-offset-4">← Back to the works</a>
  </section>
</Base>
